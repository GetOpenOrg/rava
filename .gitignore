# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# Java 编译产物
*.class

# Rust 构建产物
output/target/

# 代码生成产物（由 codegen 脚本生成，不提交）
# Cargo.toml / build.rs 由 git 管理，只忽略生成的 .rs 源文件
# 注意：用文件模式而非目录模式，以便例外规则能生效
output/jdk_classes/src/**/*.rs
!output/jdk_classes/src/**/*_impl.rs
output/user/src/
output/user/Cargo.toml

# macOS
.DS_Store
docs/reports/jdk-scan-*
/.claude/worktrees
/output/runs
