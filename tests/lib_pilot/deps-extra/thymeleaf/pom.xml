<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>local.rava</groupId>
  <artifactId>pilot-deps-extra-thymeleaf</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>pilot-deps-extra-thymeleaf</name>
  <description>deps-extra 并列模块（方案 A 双版本并存，docs/plans/2026-10-13-lib-pilot-dual-version-mechanism.md）：
    独立 pom，不继承主模块 tests/lib_pilot/deps/pom.xml。成因——thymeleaf 3.1.3.RELEASE 托管 ognl 3.3.4
    （thymeleaf-parent 3.1.3.RELEASE 属性 ognl.version 实测值），主模块锁钉 ognl 3.4.14（OgnlCollection/
    Context/Eval 三个单文件 pilot golden 已按 3.4.14 存档，不能降级）；3.4.14 对 thymeleaf 3.1.3 是
    OgnlContext 构造器签名失配。Maven 单 pom 对同 GA 只能产出一个版本，双版本经并列模块并存。
    templates 项目 form.toml 的 deps 键指到本模块锁 deps-extra/thymeleaf/target/deps.lock.toml，
    故本模块须自持该项目全部 cp 条目（FreeMarker / Velocity 与主模块同版钉值）。
    用法：scripts/fetch_pilot_deps.sh（主模块后循环处理 deps-extra 各模块，同一取包与锁生成口径）。</description>

  <dependencies>
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf</artifactId>
      <version>3.1.3.RELEASE</version>
    </dependency>
    <!-- 显式钉 3.3.4（与 thymeleaf-parent 3.1.3.RELEASE 托管值一致）：本模块内无调解冲突，
         钉值即文档——与主模块的 3.4.14 并存是本模块存在的原因 -->
    <dependency>
      <groupId>ognl</groupId>
      <artifactId>ognl</artifactId>
      <version>3.3.4</version>
    </dependency>
    <!-- templates 项目另两个引擎与运行前置（版本与主模块钉值一致；javassist 随 ognl 3.3.4 传递 3.29.0-GA，
         attoparser / unbescape 随 thymeleaf 传递） -->
    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
      <version>2.3.34</version>
    </dependency>
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity-engine-core</artifactId>
      <version>2.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.20.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- mvn package = 把依赖闭包（含传递）导出到 target/pilot-libs/（与主模块同一插件配置） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-pilot-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/pilot-libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
